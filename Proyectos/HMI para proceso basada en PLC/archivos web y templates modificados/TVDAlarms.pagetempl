											  %PARAM_alarmStatusId45%
											  %PARAM_alarmStatusId46%
                                              %PARAM_alarmStatusId47%
                                              %PARAM_alarmStatusId48%
                                              %PARAM_alarmStatusId49%                                          
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
]]>
  </pagebody>


  <!-- text to be inserted in the destination CGX as-is -->
  <extracgx>
    <![CDATA[c t08737<text><id>%s</id><value>%2.0f</value></text>
