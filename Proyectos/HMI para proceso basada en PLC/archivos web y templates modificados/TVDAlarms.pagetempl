  <!-- text to be inserted in the <head> of the destination page: this contains the <style> for the page -->
  <extraheader>
    <![CDATA[
    <script src="alarm.js"></script>
    
    <style>
        .rowVar1, .rowVar1 input { font: bold 18px Arial,sans-serif; }

        .rowSet, .rowSet input { font: bold 18px Arial,sans-serif; }

        .rowVar1, .rowSet { height: 50px; }

        .colLabel { width: 600px; }

        .bigBtn { font: bold 14px Arial,sans-serif; width: 100px; height: 50px; margin: 5px; }

        #tblValues { position: absolute; top: 200px; left: 500px; }

        #form1 { font: normal 12px Arial,sans-serif; }

        #divONOFFStatus { position: absolute; top: 550px; left: 20px; }

       // #divMode1Status { position: absolute; top: 550px; left: 120px; }

       // #divMode2Status { position: absolute; top: 550px; left: 220px; }

       // #divMode3Status { position: absolute; top: 550px; left: 320px; }

        #divAlarms { position: absolute; top: 550px; left: 500px; }

       // #divMode4Status { position: absolute; top: 550px; left: 700px; } 
        
        #divDate { position: absolute; top: 680px; left: 20px; font: bold 16px Arial,sans-serif; }

        #divTime { position: absolute; top: 680px; left: 200px; font: bold 16px Arial,sans-serif; }
        

        <!-- CUSTOM STYLING -->
        body { font-family: "Lato", sans-serif; transition: background-color .5s;
        }

        /*Content area for controls to be displayed*/
        #alarmMain { transition: margin-left .5s; padding: 16px; }

        /*Alarm Table*/
        #tblAlarms { width: 100%; border-style: none; table-layout: fixed;}

        #tblAlarms th { font-size: 16px; font-weight: bold; }

        #tblAlarms td { font-size: 15px;  font-weight: normal; }

        #alarmStatus input { border: none; background-color: white; font-size: 16px; font-weight: normal; }

        #UI input { border:none; font-weight: normal; font-size: 16px; height: 25px; }

        /*Images right side of the content page*/
        #DivImages img { display: inline-block; margin-left: 50px; }

        /*Style for search text box*/
        #alarmSearch input { border: none; border-bottom: solid 1px black; }

        #alarmSearch img { display: inline-block; }

        .col-md-12 { padding-right: 0px; }

        /*Horizontal BARS*/
        .menu-icon > .line { background-color: white; height: 2px; display: block; width: 25px; }

        .menu-icon > .line + .line { margin-top: 8px; }

        /*Vertical DOTS*/
        .showLeft {
            background-color: #green !important;
            border: 0px solid #0d77b6 !important;
            text-shadow: none !important;
            color: #fff !important;
            padding: 10px;
        }

        .icons li {
            background: none repeat scroll 0 0 #fff;
            height: 7px;
            width: 7px;
            line-height: 0;
            list-style: none outside none;
            margin-right: 15px;
            margin-top: 3px;
            vertical-align: top;
        }
		#UI input {  border: none; background-color: white; font-size: 16px; font-weight: normal; }
        
        .container-fluid { background-color: white; }

        /**/
        #MainHeading { display: inline-block; margin-left: 5px; font-size: 24px; }

        #alarmNameSearch {  height: 30px; 
                      background-image: url('Search.png'); 
                      background-repeat: no-repeat; 
                      background-position: right; 
                      background-size: 20px; 
                      font-size: 18px;
                      font-weight: normal;                      
                    }

        .title { display: none; }
        
        /*Desktop Display Style*/
        @media (min-width: 1024px) {
            //#OptionDiv { display: none; }
			#alarmSearch {width: 50%;}
            #alarmNameSearch { width: 50%; }
            //#OptionDD { display: none; }
            #LeftPopupDiv { display: none; }
            #alarmMain { margin-left:40px; padding: 10px; }
        }

        /*Teblate Display Style*/
        @media (min-width: 601px) and (max-width: 1023px) {
            .col-md-12 { padding-right: 0px;}

            #DivImages { width: 40%; }
            #DivImages img{ margin-left: 20px;}
            //#OptionDiv { display: none; }
			
            #alarmSearch { width: 60%; }
            #alarmNameSearch { width: 60%; }
            #LeftPopupDiv { display: none; }
            #Pmain { margin-left:10px; padding: 10px; }
            #UI input { width: 70%; }
            [class*="col-"] {
                        float: none;
                        }

            .closeIconSmallDevices {
                display: none;
            }              
            
        }

        /*Mobile Display Style*/
        @media (max-width: 600px) {
            #DivImages { display: none; }
            //#OptionDiv { display:inline-block; z-index: -1 ; margin-top: 12px; }
            #DivImages img{ margin-left: 20px; }
            #alarmSearch { width: 100%; }
            #alarmNameSearch { width: 100%; }
            #AppName { display: none; }
            #alarmMain{margin-left: 0px;}
            #UI input { width: 80px; }
            #alarmMain { margin-left:10px; padding: 10px; }
        }        
        
      #Elements a{ color: black; font-size: 14px; font-weight: normal;}        
      
      
    </style>
  
]]>
  </extraheader>


  <!-- contents of the page body: this references the <param> below with the syntax %PARAM_id% -->
  <pagebody>

    <![CDATA[
 

           <div class="container-fluid">


            <!-- Second Row -->
            <div class="row" id="MainContentAreaDiv" >
                <div class="col-md-10" id = "SubContentAreaDiv">
                    <div id="alarmMain">
                        <!-- Top Search and Read, Write, Save and Load images -->
                        <div class="row" style="margin-top: 10px; margin-right: 10px;">
                            <div class="col-lg-8" id="alarmSearch">
                                <input type="text" id="alarmNameSearch" placeholder="Search Alarms" style="" />
                                <!--<a href=""><img src="Search.png" class="img img-responsive" /></a>-->
                            </div>
                           </div>
                        
                        <!-- Alarms table -->
                        <div class="row" >
                            <div id = "alarmTableMainDiv" class="col-md-12">
                                <div>
                                    <table id="tblAlarms" class="table table-responsive">
                                        <thead>
                                            <tr>
                                                <th><input type="checkbox" id="selectActive" checked /> Active Alarms</th>
                                                <th></th>
												<th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                              %PARAM_alarmStatusId0%
                                              %PARAM_alarmStatusId1%
                                              %PARAM_alarmStatusId2%
                                              %PARAM_alarmStatusId3%
                                              %PARAM_alarmStatusId4%
                                              %PARAM_alarmStatusId5%
